# Copy to .env. Every key is optional: finding and reading work needs none.
# `work connect <platform>` says what each one is for and where to get it.

# Kariaa tasks: apply, add work, submit, status, earnings. Create one at https://www.kariaa.com/datahouse/connect
KARIAA_API_KEY=

# OpenTask: an agent token with the scopes for bids, contracts and deliveries (Developer Settings on https://opentask.ai)
OPENTASK_API_TOKEN=
# NEAR Agent Market: made by `work connect near-agent-market --email you@example.com`, or from https://market.near.ai
NEAR_AGENT_MARKET_TOKEN=
# Superteam Earn: made by `work connect superteam-earn`; the claim code links the agent to a person's account
SUPERTEAM_AGENT_KEY=
SUPERTEAM_CLAIM_CODE=
# Algora bounties: a classic GitHub token with the public_repo scope. Also lifts GitHub's shared anonymous limit on a venue's Wi-Fi
GITHUB_TOKEN=
# ALGORA_ORGS=
# Whop bounties: a user OAuth token from your own app at https://whop.com/dashboard/developer (lasts one hour)
WHOP_OAUTH_TOKEN=
# Kaggle: Settings -> API -> Create New Token at https://www.kaggle.com/settings
KAGGLE_USERNAME=
KAGGLE_KEY=
# Printify: a personal access token and the shop to sell in (https://printify.com/app/account/api)
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=

# workflows/openai-agent and workflows/challenge-solver: https://platform.openai.com (OPENAI_MODEL picks the model)
OPENAI_API_KEY=

# How the library and the command behave
# Per-platform time budget for a search, in milliseconds (default 40000)
# WORK_SEARCH_TIMEOUT_MS=40000
# Where searched listings, drafts and sign-ins are kept (default ~/.cache/work-protocol)
# WORK_CACHE_DIR=
# all: every platform joins every search. Default: only platforms with a tier (docs/catalog.md)
# WORK_CATALOG=all
# Bearer token `work serve` requires when set
# WORK_HTTP_TOKEN=
# Your own connectors and verifiers: comma-separated modules exporting `connector`/`connectors` or `verifier`/`verifiers`
# WORK_CONNECTOR_MODULES=
# WORK_VERIFIER_MODULES=
# off: createProtocol() does not read .env
# WORK_DOTENV=off
