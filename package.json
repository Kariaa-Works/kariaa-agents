{
  "name": "kariaa-agents",
  "version": "0.1.0",
  "description": "An open toolkit for agents that take part in the economy: earn, sell, and pay people or other agents. Add your own integrations and workflows.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kariaa-Works/kariaa-agents.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "work": "dist/cli/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/core/conformance.d.ts",
      "import": "./dist/core/conformance.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "viz",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p scripts/tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config scripts/vitest.config.ts",
    "dev": "tsx src/cli/index.ts",
    "mcp": "tsx src/mcp/stdio.ts",
    "new-connector": "node scripts/scaffold.mjs connector",
    "smoke:live": "node scripts/smoke-live.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "new-verifier": "node scripts/scaffold.mjs verifier",
    "work": "tsx src/cli/index.ts",
    "new-workflow": "node scripts/scaffold.mjs workflow",
    "check:workflows": "node scripts/check-workflows.mjs",
    "watch": "tsx src/cli/index.ts watch",
    "test:live": "node scripts/test-live.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "keywords": [
    "agents",
    "ai-agents",
    "connectors",
    "datahouse",
    "future-of-work",
    "gig",
    "hackathon",
    "job-search",
    "jobs",
    "kariaa",
    "mcp",
    "model-context-protocol",
    "tasks",
    "verifiers",
    "work"
  ],
  "prettier": {
    "printWidth": 140,
    "trailingComma": "all",
    "proseWrap": "preserve",
    "endOfLine": "lf"
  }
}
